{
  "name": "focusbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/content.js src/background.js --bundle --format=iife --outdir=dist",
    "watch": "esbuild src/content.js src/background.js --bundle --format=iife --outdir=dist --watch",
    "test": "node test/run.mjs",
    "test:match": "node test/unit.mjs && node test/match-eval.mjs && node test/e2e-match.mjs",
    "test:all": "npm test && npm run test:match && npm run test:previous",
    "test:previous": "node test/previous-fingerprint.mjs && node test/previous-store.mjs",
    "test:extension": "npm run build && node test/previous-extension.mjs"
  },
  "dependencies": {
    "dom-accessibility-api": "^0.7.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.48.0"
  }
}
